# ── 环境变量（复制为 .env 后填写）────────────────────────────────────────────
# 铁律：任何 Key 只能存在于后端环境变量中，禁止进入前端产物。
#   唯一已知例外：高德 JS API Key（frontend/.env.local 的 NEXT_PUBLIC_AMAP_JS_KEY），
#   它必须出现在浏览器加载的脚本 URL 里；清单见 frontend/.env.example。
# 本项目在缺少搜索/地图 Key 时仍可完整运行（降级模式），见 PRD §15.5 降级矩阵。
#
# ⚠️ 优先级：**已导出的环境变量会盖住本文件**（pydantic-settings 的规则），
#    而且空值也算"已经设置" —— shell 里一个 `export TAVILY_API_KEY=`（空）
#    就能让本文件里填好的 Key 读不进来。排查：`printenv TAVILY_API_KEY`、
#    临时绕过：`env -u TAVILY_API_KEY make ...`。详见 RUNNING.md §8.8。

# ── 运行 ────────────────────────────────────────────────────────────────────
ENV=development
FRONTEND_URL=http://localhost:3000

# 下面两个键**目前没有任何代码读**（保留是为了不改变既有 .env 的语义）：
# 后端监听端口由 `uvicorn --port` 决定（Makefile 里写死 8000）；
# CORS 白名单用的是 FRONTEND_URL。面板上也不再显示它们。详见 RUNNING.md §8.9。
BACKEND_PORT=8000
API_BASE_URL=http://localhost:8000

# 数据库：改成你的系统用户名（命令行执行 whoami 查看）
DATABASE_URL=postgresql+asyncpg://tanjiaxi@127.0.0.1:5432/tripdecider_dev
TEST_DATABASE_URL=postgresql+asyncpg://tanjiaxi@127.0.0.1:5432/tripdecider_test
SESSION_SECRET=dev-only-change-me-in-production

# ── LLM（DeepSeek）──────────────────────────────────────────────────────────
# Key 未配置时 LLM_PROVIDER 自动降级为 null（规则引擎 + 模板兜底）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# 保留档位：这两个字段与开发面板都在（切 provider 时按它们判断"有没有 Key"），
# 但 registry 里**没有** OpenAI / Anthropic 的实现，填了也不会被调用。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TIER_FAST_MODEL=deepseek-flash
LLM_TIER_STRONG_MODEL=deepseek-v4-pro
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=1

# ── 搜索（可选；无 Key 时使用 seed_only，只读本地知识库）─────────────────────
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SERPER_API_KEY=
BING_SEARCH_API_KEY=
ENABLE_LOCAL_FETCH=false
SEARCH_MAX_QUERIES_PER_PLAN=8

# ── 地图（可选；无 Key 时 osrm → haversine 降级）─────────────────────────────
MAP_PROVIDER=auto
AMAP_WEB_KEY=
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_USER_AGENT=TripDecider/1.0 (dev@example.com)
MAP_MAX_CALLS_PER_PLAN=40

# ── 天气（可选，open-meteo 免费无 Key）──────────────────────────────────────
WEATHER_PROVIDER=open_meteo

# ── 成本与限流（★ 真正生效的是 config/limits.yaml，不是这里 ★）──────────────
# 熔断阈值 / 限流次数 / 全局日预算的**唯一事实源是 `config/limits.yaml`**
# （开发面板的「配置文件」卡片可以直接改，改错会被 YAML 强校验拦下）。
# 下面这几个是同名镜像：**代码不读它们**，填了不会改变熔断行为 ——
# 早期版本里 `/health` 甚至报的是这里的值，而熔断器读的是 YAML（见 RUNNING.md §8.9）。
PLAN_COST_CIRCUIT_BREAKER_CNY=1.0
SEARCH_COST_CIRCUIT_BREAKER_CNY=0.3
RATE_LIMIT_COLD_PLANS_PER_DAY=5
GLOBAL_DAILY_BUDGET_CNY=20

# ── 前端 ────────────────────────────────────────────────────────────────────
# ⚠️ Next.js 只读 **frontend/ 目录下**的 .env*（例如 frontend/.env.local），
# 写成 `frontend/.env.local` 的形式（该文件已在 .gitignore 里），不要写在这里 ——
# 这里的值不会被前端进程读到。下面只是提醒你有哪些前端变量：
#
# 首页 Hero 背景视频。不配 = 用内置默认资源；配了就用你的（必须可公开访问）。
# NEXT_PUBLIC_HERO_VIDEO_URL=https://your-cdn.example.com/hero.mp4

# ── 后台 ────────────────────────────────────────────────────────────────────
ADMIN_TOKEN=

# ── 测试用故障注入（生产禁止设置）──────────────────────────────────────────
# 取值示例：llm_timeout | llm_invalid_json | search_500 | map_500 | db_down ...
FAULT_INJECTION=
